# Copy this file to .env and fill it in. .env is git-ignored: never commit it, never paste its values anywhere.

# --- Agent identities -------------------------------------------------------------------------------------------
# One seed per agent: any long random string (for example two GUIDs joined together).
# The seed fixes the agent's address and its Agentverse mailbox, so keep it secret and do not change it afterwards.
ORCHESTRATOR_SEED_PHRASE=
DISCOVERY_SEED_PHRASE=
ANALYST_SEED_PHRASE=
ACTION_SEED_PHRASE=

# --- External services -------------------------------------------------------------------------------------------
# ASI:One LLM API key (https://asi1.ai, dashboard). Without it the agents still run, using keyword fallbacks.
ASI1_API_KEY=
# GitHub classic personal access token with the public_repo scope, from a THROWAWAY demo account.
# This single shared token is used for searching, verifying and (after approval) forking and commenting.
GITHUB_TOKEN=

# --- Safety -----------------------------------------------------------------------------------------------------
# While DEMO_MODE is true, real GitHub writes (fork, comment, branch) happen ONLY on repositories listed here.
# Every other repository gets a dry run that shows what would have happened. Comma-separated owner/repo.
DEMO_MODE=true
ALLOWED_TARGET_REPOS=

# --- Optional ---------------------------------------------------------------------------------------------------
# Ports (defaults shown; each agent is its own process)
ORCHESTRATOR_PORT=8000
DISCOVERY_PORT=8001
ANALYST_PORT=8002
ACTION_PORT=8003
# LLM model overrides
# LLM_FAST_MODEL=asi1-mini
# LLM_MAIN_MODEL=asi1
# Use an explicit agent address instead of deriving it from the seed
# DISCOVERY_ADDRESS=
# ANALYST_ADDRESS=
# ACTION_ADDRESS=
# ORCHESTRATOR_ADDRESS=
# Run without Agentverse mailboxes (local development / end-to-end tests only)
# LOCAL_ONLY=true
